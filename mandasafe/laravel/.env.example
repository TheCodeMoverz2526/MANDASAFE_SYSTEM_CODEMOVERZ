APP_NAME=MandaSafe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5500

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# MandaSafe
# ---------------------------------------------------------------------------
# The pages (index.html, Mandasafe.html, styles.css, assets/, vendor/) are served
# from the folder above this app. Leave these unset to use that default.
# MANDASAFE_FRONTEND_ROOT=
# MANDASAFE_GEOJSON=
# MANDASAFE_LEGACY_STORE=

# Predictions and the hotspot surface are cached until the next write. 0 = never cache.
MANDASAFE_ANALYTICS_CACHE=86400

# Python interpreter (3.9+, with ml/requirements.txt installed) used to run the ML scripts in
# ml/: the severity Random Forest and the KDE hotspot surface. Set this to a full path if
# "python" isn't on PATH for the user the web server runs as.
# MANDASAFE_PYTHON_BIN=python

# Sign-in verification codes (OTP).
# Test mode is the fallback for a system with no provider yet: no provider is contacted, the
# code is generated locally and shown on the sign-in page. Filling in the Vocotext (or
# Resend) credentials below switches to real delivery on its own - a configured provider
# always wins over this setting, so it cannot be left on by accident.
# Check with: php artisan mandasafe:otp-check
OTP_TEST_MODE=true
OTP_TEST_CODE=123456

# SMS delivery through Vocotext iSMS 2FA. The provider generates the code, replaces %OTP%
# in the message with it, and verifies it on its own side. Uncomment these two and put your
# Vocotext account details in - that is all it takes to go live.
# VOCOTEXT_USERNAME=
# VOCOTEXT_PASSWORD=
# VOCOTEXT_SENDER_ID=MandaSafe
# VOCOTEXT_MESSAGE="Your MandaSafe verification code is %OTP%. Do not share it with anyone."
# VOCOTEXT_TYPE=1
# VOCOTEXT_INTERVAL=10
# VOCOTEXT_ENDPOINT=https://smtpapi.vocotext.com/isms_2fa_request.php

# Accounts are stored as +639171234567; these split the country code back off for Vocotext.
# OTP_SMS_COUNTRY_CODE=63
# OTP_SMS_COUNTRY_CODES=63,1,44,65,61,971

# Email delivery through Resend (optional — SMS alone is enough).
# RESEND_API_KEY=
# OTP_FROM_EMAIL=

# Legacy SMS provider, used only when Vocotext is not configured.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
