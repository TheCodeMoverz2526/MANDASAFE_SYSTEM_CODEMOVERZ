# MandaSafe — production settings for the VPS.
# setup-server.sh copies this to laravel/.env and fills in APP_KEY, APP_URL and the Python
# path. Everything else you set by hand (see DEPLOY.md, step 5).

APP_NAME=MandaSafe
APP_ENV=production
APP_KEY=
# Never true on a public server: it would show code, paths and settings on any error page.
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# Python virtual environment created by setup-server.sh (numpy, scipy, scikit-learn).
MANDASAFE_PYTHON_BIN=/var/www/mandasafe/mandasafe/ml/.venv/bin/python

# Shown in a bar at the top of every page. Keep it while this is a demo, so no visitor
# mistakes the site for an official Mandaluyong City website.
MANDASAFE_DEMO_NOTICE="Capstone demo by CodeMoverz — not an official Mandaluyong City website."

# Verification codes for sign-up and password reset.
# With test mode on, the code is SHOWN ON THE PAGE — anyone can sign up with any email or
# number. Acceptable for a panel demo only; for anything more, fill in Resend and/or
# Vocotext below and set test mode to false.
OTP_TEST_MODE=true

# Email codes through Resend (free tier is enough for a demo): https://resend.com
# RESEND_API_KEY=
# OTP_FROM_EMAIL=

# SMS codes through Vocotext iSMS 2FA.
# VOCOTEXT_USERNAME=
# VOCOTEXT_PASSWORD=
# VOCOTEXT_SENDER_ID=MandaSafe
# OTP_SMS_COUNTRY_CODE=63
