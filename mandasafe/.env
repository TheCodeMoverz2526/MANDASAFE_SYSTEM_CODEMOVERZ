# MandaSafe server config (read by server.js)

# OTP delivery is not wired up right now — verification codes are returned directly
# to the sign-in page instead of being emailed/texted (see sendOtp() in server.js).
# Leftover values below are unused until a provider is added back in.
# RESEND_API_KEY=re_VBdMz6vj_F4CNRzoJXKWjmRwtC8yQBoZE
# OTP_FROM_EMAIL=onboarding@resend.dev
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Python interpreter (3.9+, with ml/requirements.txt installed) used to run the ML scripts in
# ml/ (severity Random Forest, KDE hotspot surface). Set to a full path if "python" isn't on
# PATH -- it isn't on this machine, where a bare "python" hits the Windows Store's broken
# app-execution alias instead of the real interpreter.
MANDASAFE_PYTHON_BIN=C:\Users\USER\AppData\Local\Programs\Python\Python312\python.exe
